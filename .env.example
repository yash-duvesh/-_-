# Required: create a bot at https://discord.com/developers/applications
TOKEN=PASTE_BOT_TOKEN_HERE

# Lean defaults for smaller hosts
MAX_PLAYLIST_SIZE=10
DEFAULT_VOLUME=70
ENABLE_VOLUME_CONTROL=true
PRUNING=false
STAY_TIME=30
LOCALE=en

# Optional: set these to custom animated emoji markup from a server you control.
# Upload animated GIF emojis to Discord, then paste the copied markup, e.g. <a:nfx_music:123456789012345678>
# Leave these commented to use the built-in emoji fallbacks.
# EMOJI_MUSIC=
# EMOJI_PLAY=
# EMOJI_PAUSE=
# EMOJI_SKIP=
# EMOJI_STOP=
# EMOJI_VOLUME_DOWN=
# EMOJI_VOLUME_UP=
# EMOJI_SHUFFLE=
# EMOJI_LOOP=
# EMOJI_QUEUE=
# EMOJI_LYRICS=
# EMOJI_REQUESTER=
# EMOJI_DURATION=
# EMOJI_SOURCE=
